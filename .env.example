# ==============================================================================
# ARIA Environment Configuration (100% Permanent Free-Tier)
# ==============================================================================

# LLM Inference Providers
# Groq: 14,400 req/day free (https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google AI Studio: Gemini 2.0 Flash 1,500 req/day free (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# OCI Always Free ARM VM (Optional local Ollama fallback)
OLLAMA_BASE_URL=http://localhost:11434

# State Persistence & Memory
# Supabase PostgreSQL: 500MB DB free tier (https://supabase.com)
SUPABASE_DB_URL=postgresql://postgres.yourproject:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Upstash Redis: 10,000 commands/day free (https://upstash.com)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Cloudflare R2 Object Storage: 10GB, zero egress fees (https://dash.cloudflare.com)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=aria-storage

# Repository & State Management
# Fine-Grained GitHub PAT (read/write contents, issues, PRs - NO secrets access)
GITHUB_TOKEN=github_pat_your_token_here
GITHUB_REPOSITORY=yourusername/aria-agent
STATE_REPOSITORY=yourusername/aria-brain

# Email Communication (Gmail App Password)
EMAIL_ACCOUNT=your-email@gmail.com
EMAIL_APP_PASSWORD=abcd-efgh-ijkl-mnop
IMAP_SERVER=imap.gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Out-of-Band Security & Approvals
# Ntfy.sh: Free instant push notifications (https://ntfy.sh)
NTFY_TOPIC=aria-approval-alert-youruniquekey
AUTO_APPROVAL_ENABLED=false

# Operational Runtime
JOB_START_EPOCH=0
MAX_JOB_SECONDS=20000
